{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOTA-of-EDA topic registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic_id", "short_name", "display_name", "aliases", "description", "baselines"],
  "properties": {
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parent_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_order": {
      "type": "integer",
      "minimum": 0
    },
    "short_name": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "review_triggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "baselines": {
      "type": "array",
      "items": { "$ref": "#/definitions/baseline" }
    }
  },
  "definitions": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_id",
        "short_name",
        "display_name",
        "role",
        "nomination",
        "publication",
        "links",
        "compare_when",
        "benchmark_scope",
        "metrics",
        "reproducibility",
        "caveats"
      ],
      "properties": {
        "baseline_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "short_name": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": [
            "canonical_baseline",
            "candidate_recent_baseline",
            "artifact_baseline",
            "historical_reference"
          ]
        },
        "nomination": {
          "type": "string",
          "enum": ["maintainer", "community", "self_nominated"]
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "venue", "year", "bibtex"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "venue": { "type": "string", "minLength": 1 },
            "year": { "type": "integer", "minimum": 1980, "maximum": 2100 },
            "doi": { "type": "string" },
            "bibtex": { "type": "string", "minLength": 1 }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paper_url": { "type": "string" },
            "pdf_url": { "type": "string" },
            "arxiv_url": { "type": "string" },
            "repo_url": { "type": "string" },
            "project_url": { "type": "string" }
          }
        },
        "compare_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "benchmark_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reproducibility": {
          "type": "string",
          "enum": ["reproduced", "artifact_available", "paper_only", "unknown"]
        },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
